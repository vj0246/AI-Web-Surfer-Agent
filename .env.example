# Ollama (must be running on host before starting backend)
OLLAMA_HOST=http://localhost:11434
PLANNER_MODEL=phi3:mini
SYNTHESIZER_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend → backend URL (used by browser, so must be reachable from client machine)
VITE_BACKEND_API_URL=http://localhost:8000

# Scraper tuning
SCRAPER_HEADLESS=false        # false = open a real Chrome window and watch the cursor surf
SCRAPER_MIN_DELAY_MS=2000
SCRAPER_MAX_DELAY_MS=4000

# Multi-agent orchestration
MAX_RESEARCHERS=3            # parallel researcher agents per round
MAX_CRITIC_ROUNDS=1          # extra gap-filling rounds the critic may trigger
MAX_CONCURRENT_BROWSERS=2    # simultaneous headed Chrome windows across researchers

# Cache TTL in seconds (default 30 min)
CACHE_TTL_SECONDS=1800
